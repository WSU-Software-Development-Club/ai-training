# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# CORS Configuration
# For local development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# For production (Render), set to Vercel frontend URL:
# CORS_ORIGINS=https://your-app.vercel.app

# Supabase Configuration
# Get these from your Supabase dashboard
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# Production Notes:
# - Set FLASK_ENV=production on Render
# - Set FLASK_DEBUG=False on Render
# - Update CORS_ORIGINS with your actual Vercel URL after deployment
# - PORT is automatically set by Render (usually 10000)
