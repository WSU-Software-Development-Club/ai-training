# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# CORS Configuration
# For local development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# For production, set to the Vercel frontend origin:
# CORS_ORIGINS=https://your-app.vercel.app

# Database Configuration (self-hosted Postgres on troyster)
# On the compose network the host is the `db` service:
DATABASE_URL=postgresql://aitraining:CHANGE_ME@db:5432/aitraining

# College Football Data API key (optional).
# Enables the team page's historical (past-season) records. Without it, only
# the current season loads (from the NCAA feed). Free key: collegefootballdata.com
# CFBD_API_KEY=your_cfbd_key

# Production Notes:
# - Set FLASK_ENV=production and FLASK_DEBUG=False in production
# - Update CORS_ORIGINS with the actual Vercel frontend origin
# - Prefer running under gunicorn instead of the Flask dev server
