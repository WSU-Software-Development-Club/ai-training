# Matchup Intelligence Engine — environment (names only; never commit real values).
# Secrets come from the environment / this .env, never from config.yaml or code.

# Postgres. On troyster's compose network use the service hostname; from a
# remote runner (Tailscale) use the troyster IP like ml/env.example does.
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/DBNAME

# CFBD (Tier 3 for rosters/depth-charts/per-player recruiting). Reuses the same
# key the ML pipeline uses.
CFBD_API_KEY=your_cfbd_api_key

# Self-hosted Ollama (runs as a compose service on troyster; not publicly exposed).
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma3

# Sample-size guard: historical_rate is only served when sample_size >= this.
SAMPLE_SIZE_THRESHOLD=30

# HTTP timeout (seconds) for Ollama / data-source calls.
REQUEST_TIMEOUT=60
