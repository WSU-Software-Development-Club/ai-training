# Stacked ensemble (ml/ensemble/) — environment (names only; never commit real values).
# Secrets come from the environment / this .env, never from config.yaml or code.

# Postgres. From a remote runner (Tailscale) use the troyster IP like ml/env.example does;
# on troyster's compose network use the service hostname instead.
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/DBNAME

# Self-hosted Ollama (feature-EXTRACTION branch only — see llm_features.py; never
# used for game predictions). Runs as a compose service on troyster.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma3
REQUEST_TIMEOUT=180

# Leakage-free OOF stacking.
K_FOLDS=5
RANDOM_STATE=42

# Two-stage upset/mispricing thresholds.
MISPRICING_THRESHOLD=0.15
UPSET_RANK_GAP=10

# Where trained ensemble artifacts are written/loaded (defaults to ml/ensemble/models/).
MODEL_DIR=
